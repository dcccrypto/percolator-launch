FROM node:22-slim

WORKDIR /app

# Install tsx globally for running TypeScript
RUN npm install -g tsx

# Copy root package.json (has all deps incl. dotenv, @solana/web3.js etc)
COPY package.json ./

# Install all deps (including devDeps like dotenv, tsx)
RUN npm install --ignore-scripts

# Copy source
COPY packages/core/ packages/core/
COPY services/sim-oracle.ts services/sim-bots.ts services/sim-service.ts services/
COPY config/sim-markets.json config/

EXPOSE 3001

CMD ["npx", "tsx", "services/sim-service.ts"]
