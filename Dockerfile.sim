FROM node:22-slim AS builder

WORKDIR /app

# Install pnpm + tsx
RUN npm install -g pnpm@10 tsx

# Copy workspace config + lockfile
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy package.jsons for workspace resolution
COPY packages/core/package.json packages/core/
COPY packages/server/package.json packages/server/

# Install deps
RUN pnpm install --frozen-lockfile

# Copy source needed by sim service
COPY packages/core/ packages/core/
COPY services/ services/
COPY config/ config/

# Build core (sim-oracle/bots import from packages/core/src directly via tsx)
RUN cd packages/core && npx tsc --build || true

# Production stage
FROM node:22-slim

WORKDIR /app

RUN npm install -g pnpm@10 tsx

COPY --from=builder /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=builder /app/packages/core/ packages/core/
COPY --from=builder /app/services/ services/
COPY --from=builder /app/config/ config/
COPY --from=builder /app/node_modules node_modules/
COPY --from=builder /app/packages/core/node_modules packages/core/node_modules/ 

EXPOSE 3001

CMD ["npx", "tsx", "services/sim-service.ts"]
