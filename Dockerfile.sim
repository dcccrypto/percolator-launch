FROM node:22-slim

WORKDIR /app

# Install tsx globally for running TypeScript
RUN npm install -g tsx

# Copy just what we need — no pnpm workspace resolution
COPY package.json ./

# Install deps directly with npm (avoids pnpm workspace lockfile issues)
RUN npm install --omit=dev --ignore-scripts 2>/dev/null || npm install --ignore-scripts

# Copy source
COPY packages/core/ packages/core/
COPY services/sim-oracle.ts services/sim-bots.ts services/sim-service.ts services/
COPY config/sim-markets.json config/

EXPOSE 3001

CMD ["npx", "tsx", "services/sim-service.ts"]
