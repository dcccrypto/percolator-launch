# Vercel builds this app/ dir with `npm install` (the pnpm workspace lockfile
# lives at the repo root, out of this dir's scope). @privy-io/node declares an
# OPTIONAL peer on @solana/kit@^5.1.0 while the app uses @solana/kit@^6.1.0, so
# strict npm resolution (ERESOLVE) fails. The optional peer is unused (server SDK)
# — skipping it is safe and matches how pnpm resolves locally + how the working
# production deploys install (`npm install --legacy-peer-deps`). pnpm ignores this
# key, so local dev + CI (pnpm) are unaffected.
legacy-peer-deps=true
