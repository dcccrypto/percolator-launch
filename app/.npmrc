# Vercel builds this app/ dir with `npm install` (the pnpm workspace lockfile
# lives at the repo root, out of this dir's scope). @privy-io/node declares an
# OPTIONAL peer on @solana/kit@^5.1.0 while the app uses @solana/kit@^6.1.0, so
# strict npm resolution (ERESOLVE) fails. The optional peer is unused (server SDK)
# — skipping it is safe and matches how pnpm resolves locally + how the working
# production deploys install (`npm install --legacy-peer-deps`). pnpm ignores this
# key, so local dev + CI (pnpm) are unaffected.
legacy-peer-deps=true

# app/package-lock.json (added alongside this file) pins the exact resolved tree
# for that `npm install --legacy-peer-deps`. Root cause of a follow-up prod
# incident: Vercel restores a cached node_modules from the previous deploy and
# runs an INCREMENTAL `npm install` on top of it ("added N packages, changed M
# packages"), never a clean install. Without a lockfile, npm's floating `^`
# ranges + legacy-peer-deps' relaxed peer checking let that incremental patch
# land a different, sometimes-broken transitive tree than a fresh install would
# — e.g. a stale/duplicated nested copy of a package that confuses Turbopack's
# Edge Function bundler into pulling non-Edge-safe code into middleware.js
# (surfaced as Vercel's "referencing unsupported modules" deploy-step error,
# mis-attributed to whatever userland file happened to share that chunk).
# The lockfile makes `npm install`/`npm ci` reconcile to an exact tree instead
# of incrementally floating, closing that non-determinism. Regenerate it with
# `npm install --legacy-peer-deps` after any dependency bump and commit the
# result alongside the package.json change.
