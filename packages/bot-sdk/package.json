{
  "name": "@percolator/bot-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Typed fetch client for the Percolator v2.2 bot API (/api/v1). Reads, quotes, unsigned builders, tx status, SSE. Never signs or sends.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "files": ["src", "examples", "README.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
